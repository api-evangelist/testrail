{
  "opencollection": "1.0.0",
  "info": {
    "name": "TestRail API (v2) Cases Users API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.testrail.io/index.php?/api/v2/get_users"
          },
          "docs": "Returns a list of users."
        },
        {
          "info": {
            "name": "Get user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.testrail.io/index.php?/api/v2/get_user/:user_id",
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns an existing user by ID."
        },
        {
          "info": {
            "name": "Get user by email",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.testrail.io/index.php?/api/v2/get_user_by_email",
            "params": [
              {
                "name": "email",
                "value": "",
                "type": "query",
                "description": "The email address to look up."
              }
            ]
          },
          "docs": "Returns an existing user by email address."
        }
      ]
    }
  ],
  "bundled": true
}