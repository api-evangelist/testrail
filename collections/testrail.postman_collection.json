          "name": "Get plans for a project",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/get_plans/1" },
            "description": "Returns test plans for project 1. Bulk endpoint, up to 250 records per page."
          }
        },
        {
          "name": "Add plan",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Release 1.0 test plan\"\n}" },
            "url": { "raw": "{{baseUrl}}/add_plan/1" },
            "description": "Creates a new test plan in project 1, optionally with entries."
          }
        },
        {
          "name": "Add plan entry",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"suite_id\": 1,\n  \"include_all\": true\n}" },
            "url": { "raw": "{{baseUrl}}/add_plan_entry/1" },
            "description": "Adds one or more runs to plan 1 as an entry, optionally across configurations."
          }
        },
        {
          "name": "Close plan",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/close_plan/1" },
            "description": "Closes plan 1 and archives its runs and results."
          }
        }
      ]
    },
