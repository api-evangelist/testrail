            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Verify login\"\n}" },
            "url": { "raw": "{{baseUrl}}/add_case/1" },
            "description": "Creates a new test case in section 1."
          }
        },
        {
          "name": "Update case",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Verify login (updated)\"\n}" },
            "url": { "raw": "{{baseUrl}}/update_case/1" },
            "description": "Updates an existing test case."
          }
        },
        {
          "name": "Delete case",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/delete_case/1" },
            "description": "Deletes an existing test case."
          }
        }
      ]
    },
    {
      "name": "Tests",
      "item": [
